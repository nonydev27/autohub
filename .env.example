# Copy this file to .env.local and fill in real values.
# Vite only exposes variables that start with VITE_ to your React code.
# Read them in code with import.meta.env.VITE_...
# Restart `npm run dev` after editing env files.

# Firebase console → Project settings (gear icon) → General → Your apps → Web app → SDK setup (Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# https://gnews.io → Dashboard
VITE_GNEWS_API_KEY=
